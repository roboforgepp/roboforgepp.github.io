---
import Container from "./Container.astro";
import SocialIcon from "../ui/SocialIcon.astro";
import { CONTACTS, NAV_LINKS, SITE, SOCIALS } from "../../data/site";

const year = new Date().getFullYear();
const mainContact = CONTACTS[0];
---

<footer class="border-t border-gray-200 bg-gray-50">
    <Container size="wide" class="py-14">
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
            <div class="lg:col-span-2">
                <p class="text-lg font-semibold text-gray-900">{SITE.name}</p>
                <p class="mt-2 max-w-sm text-sm text-gray-500">
                    {SITE.shortDescription}. Kujemy modułowego robota — i chętnie
                    pokażemy, jak to robimy.
                </p>
                <div class="mt-5 flex items-center gap-1">
                    {
                        SOCIALS.map((social) => (
                            <SocialIcon
                                href={social.href}
                                label={social.label}
                                icon={social.icon}
                            />
                        ))
                    }
                </div>
            </div>

            <nav aria-label="Nawigacja w stopce">
                <p
                    class="text-xs font-semibold tracking-widest text-gray-400 uppercase"
                >
                    Strona
                </p>
                <ul class="mt-4 flex flex-col gap-2 text-sm">
                    {
                        NAV_LINKS.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    class="text-gray-600 transition-colors hover:text-brand-600"
                                >
                                    {link.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>

            <div>
                <p
                    class="text-xs font-semibold tracking-widest text-gray-400 uppercase"
                >
                    Kontakt
                </p>
                <ul class="mt-4 flex flex-col gap-2 text-sm">
                    <li>
                        <a
                            href={`mailto:${mainContact.email}`}
                            class="text-gray-600 transition-colors hover:text-brand-600"
                        >
                            {mainContact.email}
                        </a>
                    </li>
                    <li class="text-gray-500">Politechnika Poznańska</li>
                    <li>
                        <a
                            href="/contact"
                            class="font-medium text-brand-600 hover:text-brand-700"
                        >
                            Napisz do nas →
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <div
            class="mt-12 flex flex-col gap-2 border-t border-gray-200 pt-6 text-sm text-gray-400 sm:flex-row sm:items-center sm:justify-between"
        >
            <p>© {year} {SITE.name} — Politechnika Poznańska</p>
            <p>Kuta ręcznie w Poznaniu.</p>
        </div>
    </Container>
</footer>
