---
/**
 * Miejsce na materiał, którego jeszcze nie mamy (§6 planu).
 * Wygląda jak kartka techniczna, a nie jak zepsuty obrazek — stronę można
 * pokazać zarządowi przed dostarczeniem zdjęć i renderów.
 */
interface Props {
    /** Co ma tu wylądować, np. „Render platformy", „Zdjęcie zespołu". */
    label: string;
    /** Od kogo czekamy na materiał — widoczne tylko w trybie dev. */
    awaiting?: string;
    ratio?: "video" | "square" | "wide";
    class?: string;
}

const { label, awaiting, ratio = "video", class: className = "" } = Astro.props;

const RATIOS = {
    video: "aspect-video",
    square: "aspect-square",
    wide: "aspect-[21/9]",
} as const;
---

<div
    class:list={[
        "relative flex flex-col items-center justify-center gap-2 overflow-hidden rounded-card border border-dashed border-(--tone-line) bg-(--tone-surface) text-center",
        RATIOS[ratio],
        className,
    ]}
>
    <div
        aria-hidden="true"
        class="absolute inset-0 opacity-60 [background-image:linear-gradient(var(--tone-line)_1px,transparent_1px),linear-gradient(90deg,var(--tone-line)_1px,transparent_1px)] [background-size:32px_32px]"
    >
    </div>
    <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="relative h-7 w-7 text-(--tone-faint)"
        aria-hidden="true"
    >
        <rect x="3" y="3" width="18" height="18" rx="2"></rect>
        <circle cx="9" cy="9" r="2"></circle>
        <path d="m21 15-4.5-4.5L7 21"></path>
    </svg>
    <p class="relative px-4 text-sm font-medium text-(--tone-muted)">{label}</p>
    {
        import.meta.env.DEV && awaiting && (
            <p class="relative px-4 text-xs text-amber-600">
                czekamy na: {awaiting}
            </p>
        )
    }
</div>
