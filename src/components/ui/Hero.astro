---
import Container from "../layout/Container.astro";
import robokop from "../../assets/robokop_np_N.svg";
import { INK_TONE } from "../../lib/tone";

/**
 * Ciemny hero strony głównej. Iskry na <canvas> to port z `main.js` szablonu —
 * ~50 linii bez zależności, wyłączone przy `prefers-reduced-motion`.
 */
interface Props {
    kicker: string;
    /** Środkowe słowo dostaje kontur zamiast wypełnienia — akcent z szablonu. */
    titleLines: [string, string, string];
    description: string;
}

const { kicker, titleLines, description } = Astro.props;
---

<section
    class:list={[
        "relative isolate overflow-hidden bg-ink text-white",
        INK_TONE,
    ]}
>
    <canvas
        id="hero-sparks"
        class="pointer-events-none absolute inset-0 h-full w-full"
        aria-hidden="true"></canvas>

    <div
        aria-hidden="true"
        class="pointer-events-none absolute -top-1/3 left-1/2 -z-10 h-[70rem] w-[70rem] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(0,102,255,.22),transparent_62%)] blur-3xl"
    >
    </div>
    <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 -z-10 opacity-[0.07] [background-image:linear-gradient(#fff_1px,transparent_1px),linear-gradient(90deg,#fff_1px,transparent_1px)] [background-size:56px_56px] [mask-image:radial-gradient(ellipse_at_center,#000,transparent_75%)]"
    >
    </div>

    <!--
      Znak wodny wypełnia prawą połowę hero, która przy lewo-wyrównanym
      tytule zostawała pusta. Bardzo niska krycie — ma być tłem, nie drugim
      logo obok tego w nagłówku. Poniżej `lg` znika, bo tam kolumna jest jedna.
    -->
    <img
        src={robokop.src}
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute right-8 bottom-16 -z-10 hidden w-[26rem] max-w-none opacity-[0.05] xl:right-16 lg:block"
    />

    <Container size="wide" class="relative py-24 sm:py-28 lg:pt-32 lg:pb-24">
        <p
            data-reveal
            class="flex items-center gap-3 text-sm font-semibold tracking-[0.2em] text-brand-400 uppercase"
        >
            <span class="h-px w-8 bg-brand-500" aria-hidden="true"></span>
            {kicker}
        </p>

        <h1
            data-reveal
            style="--reveal-delay:80ms"
            class="mt-8 text-5xl leading-[0.95] font-bold tracking-tighter text-balance sm:text-7xl lg:text-8xl"
        >
            <span class="block">{titleLines[0]}</span>
            <span
                class="block text-transparent [-webkit-text-stroke:1px_rgba(255,255,255,.6)]"
                >{titleLines[1]}</span
            >
            <span class="block">{titleLines[2]}</span>
        </h1>

        <div
            class="mt-12 flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between"
        >
            <div data-reveal style="--reveal-delay:160ms" class="max-w-xl">
                <p class="text-lg text-pretty text-white/64">{description}</p>
                <div class="mt-8 flex flex-wrap items-center gap-4">
                    <slot />
                </div>
            </div>

            <a
                href="#manifest"
                class="hidden shrink-0 items-center gap-3 text-xs font-semibold tracking-[0.2em] text-white/50 uppercase transition-colors hover:text-white lg:inline-flex"
            >
                Przewiń
                <span class="h-10 w-px bg-white/30" aria-hidden="true"></span>
            </a>
        </div>
    </Container>
</section>

<script>
    const canvas = document.getElementById(
        "hero-sparks",
    ) as HTMLCanvasElement | null;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const ctx = canvas?.getContext("2d");

    if (canvas && ctx && !reduced) {
        type Spark = {
            x: number;
            y: number;
            r: number;
            speed: number;
            drift: number;
            alpha: number;
            blue: boolean;
        };

        let width = 0;
        let height = 0;
        let sparks: Spark[] = [];
        let frame = 0;

        const make = (initial: boolean): Spark => ({
            x: Math.random() * width,
            y: initial ? Math.random() * height : height + Math.random() * 80,
            r: Math.random() * 1.35 + 0.25,
            speed: Math.random() * 0.6 + 0.16,
            drift: (Math.random() - 0.5) * 0.35,
            alpha: Math.random() * 0.45 + 0.08,
            blue: Math.random() > 0.72,
        });

        const resize = () => {
            const rect = canvas.getBoundingClientRect();
            const dpr = Math.min(window.devicePixelRatio || 1, 2);
            width = rect.width;
            height = rect.height;
            canvas.width = Math.round(width * dpr);
            canvas.height = Math.round(height * dpr);
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            const count = Math.min(92, Math.max(34, Math.round(width / 17)));
            sparks = Array.from({ length: count }, () => make(true));
        };

        const draw = () => {
            ctx.clearRect(0, 0, width, height);
            sparks.forEach((spark, index) => {
                spark.y -= spark.speed;
                spark.x += spark.drift;
                if (spark.y < -16 || spark.x < -16 || spark.x > width + 16) {
                    sparks[index] = make(false);
                    return;
                }
                ctx.beginPath();
                ctx.fillStyle = spark.blue
                    ? `rgba(0, 102, 255, ${spark.alpha})`
                    : `rgba(255, 255, 255, ${spark.alpha})`;
                ctx.shadowBlur = spark.blue ? 12 : 5;
                ctx.shadowColor = spark.blue
                    ? "rgba(0,102,255,.7)"
                    : "rgba(255,255,255,.35)";
                ctx.arc(spark.x, spark.y, spark.r, 0, Math.PI * 2);
                ctx.fill();
            });
            ctx.shadowBlur = 0;
            frame = window.requestAnimationFrame(draw);
        };

        resize();
        draw();
        window.addEventListener("resize", resize, { passive: true });
        // Poza ekranem animacja tylko zjada baterię.
        new IntersectionObserver((entries) => {
            for (const entry of entries) {
                window.cancelAnimationFrame(frame);
                if (entry.isIntersecting) frame = window.requestAnimationFrame(draw);
            }
        }).observe(canvas);
    }
</script>
