---
import Section from "./Section.astro";

/**
 * Duży cytat na pełną szerokość („Głos zespołu" z szablonu).
 * Etykieta po lewej, cytat po prawej — układ dwukolumnowy, żeby blok nie był
 * ścianą tekstu na całą szerokość kontenera.
 */
interface Props {
    eyebrow: string;
    quote: string;
    author: string;
    tone?: "white" | "paper" | "ink";
}

const { eyebrow, quote, author, tone = "white" } = Astro.props;
---

<Section tone={tone} space="default" size="wide">
    <div class="grid gap-8 lg:grid-cols-[14rem_1fr] lg:gap-16">
        <p
            data-reveal
            class="text-sm font-semibold tracking-widest text-brand-600 uppercase"
        >
            {eyebrow}
        </p>

        <figure data-reveal style="--reveal-delay:80ms">
            <blockquote
                class="text-2xl leading-snug font-semibold tracking-tight text-balance text-(--tone-fg) sm:text-3xl"
            >
                „{quote}"
            </blockquote>
            <figcaption
                class="mt-6 text-sm tracking-widest text-(--tone-faint) uppercase"
            >
                {author}
            </figcaption>
        </figure>
    </div>
</Section>
