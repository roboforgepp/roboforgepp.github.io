---
import SocialGlyph from "./SocialGlyph.astro";
import type { SocialIconName } from "../../data/site";

/**
 * Kafelek profilu na `/media`: ikona + nazwa serwisu + handle.
 * Cały kafelek jest linkiem, więc ikona idzie tu jako `SocialGlyph`, a nie
 * `SocialIcon` — ten drugi renderuje własne `<a>`, a `<a>` w `<a>` rozbija
 * kafelek (przeglądarka zamyka zewnętrzny link i tekst wypada poza ramkę).
 *
 * Bez `href` (profil zapowiedziany, adresu jeszcze nie mamy) kafelek renderuje
 * się jako `<div>` — pusty `<a>` nie byłby linkiem, a myliłby czytniki ekranu.
 */
interface Props {
    href: string | null;
    label: string;
    icon: SocialIconName;
    handle?: string;
}

const { href, label, icon, handle } = Astro.props;

const Tag = href ? "a" : "div";
---

<Tag
    href={href ?? undefined}
    target={href ? "_blank" : undefined}
    rel={href ? "noopener noreferrer" : undefined}
    class:list={[
        "flex h-full items-center gap-4 rounded-card border border-gray-200 bg-white p-5 transition-all duration-300 ease-forge",
        href
            ? "hover:-translate-y-1 hover:border-brand-400 hover:shadow-lg hover:shadow-brand-600/10"
            : "opacity-60",
    ]}
>
    <span
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-600"
    >
        <SocialGlyph icon={icon} class="h-5 w-5" />
    </span>

    <!-- `min-w-0` pozwala długiemu handle'owi się skrócić zamiast rozpychać kafelek. -->
    <span class="min-w-0">
        <span class="block font-semibold text-gray-900">{label}</span>
        <span class="block truncate text-sm text-gray-500">
            {href ? handle : "profil wkrótce"}
        </span>
    </span>
</Tag>
