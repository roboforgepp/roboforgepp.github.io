---
import ProjectVisual from "../visuals/ProjectVisual.astro";
import ProjectStatus from "./ProjectStatus.astro";
import Tag from "../ui/Tag.astro";
import type { Project } from "../../lib/projects";

/** Wiersz pełnej listy projektów — wizualizacja i opis, naprzemiennie stronami. */
interface Props {
    project: Project;
    /** Parzyste wiersze mają wizualizację po lewej. */
    flip?: boolean;
}

const { project, flip = false } = Astro.props;
const { data } = project;
---

<article
    data-reveal
    data-status={data.status}
    class="grid items-center gap-8 border-t border-(--tone-line) py-12 lg:grid-cols-2 lg:gap-14"
>
    <div class={flip ? "lg:order-2" : ""}>
        <div class="flex flex-wrap items-center gap-3">
            <span
                class="text-xs font-semibold tracking-[0.14em] text-(--tone-faint) uppercase"
                >{data.category}</span
            >
            <ProjectStatus status={data.status} placeholder={data.placeholder} />
        </div>

        <h2 class="mt-4 text-3xl font-bold tracking-tight text-(--tone-fg)">
            <a href={`/projects/${project.id}`} class="hover:text-brand-600">
                {data.title}
            </a>
        </h2>

        <p class="mt-3 max-w-xl text-pretty text-(--tone-muted)">{data.summary}</p>

        {
            data.tags.length > 0 && (
                <ul class="mt-5 flex flex-wrap gap-2">
                    {data.tags.map((tag) => (
                        <li>
                            <Tag>{tag}</Tag>
                        </li>
                    ))}
                </ul>
            )
        }

        <a
            href={`/projects/${project.id}`}
            class="group mt-6 inline-flex items-center gap-1.5 font-medium text-brand-600 hover:text-brand-700"
        >
            Zobacz projekt
            <span
                aria-hidden="true"
                class="transition-transform duration-200 ease-forge group-hover:translate-x-1"
                >→</span
            >
        </a>
    </div>

    <ProjectVisual
        visual={data.visual}
        cover={data.cover}
        coverAlt={data.coverAlt}
        class={`aspect-[16/10] w-full rounded-card ${flip ? "lg:order-1" : ""}`}
    />
</article>
