---
import type { CollectionEntry } from "astro:content";

import PartnerLogo from "./PartnerLogo.astro";

interface Props {
    partner: CollectionEntry<"partners">;
}

const { partner } = Astro.props;
const { data } = partner;
---

<button
    type="button"
    data-partner={partner.id}
    class="group flex h-full flex-col items-start gap-4 rounded-card border border-gray-200 bg-white p-6 text-left transition-all duration-300 ease-forge hover:-translate-y-1 hover:border-brand-400 hover:shadow-lg hover:shadow-brand-600/10"
>
    <PartnerLogo partner={partner} class="h-20" />

    <div class="flex flex-1 flex-col gap-2">
        <div class="flex flex-wrap items-center gap-2">
            <span class="font-semibold text-gray-900">{data.name}</span>
            {
                !data.confirmed && (
                    <span class="rounded-full bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-700">
                        w rozmowach
                    </span>
                )
            }
        </div>
        <p class="text-sm text-pretty text-gray-600">{data.summary}</p>
    </div>

    <span
        class="mt-auto inline-flex items-center gap-1.5 text-sm font-medium text-brand-600"
    >
        Szczegóły
        <span
            aria-hidden="true"
            class="transition-transform duration-200 ease-forge group-hover:translate-x-1">→</span
        >
    </span>
</button>
