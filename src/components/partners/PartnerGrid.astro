---
import { render, type CollectionEntry } from "astro:content";

import PartnerTile from "./PartnerTile.astro";

/**
 * D6 — kafelki z logo, szczegóły dopiero po kliknięciu. Przy rosnącej liczbie
 * partnerów siatka rośnie w bok, a nie w dół o kolejne akapity opisu.
 *
 * Okno używa natywnego `<dialog>`: focus trap, Esc i tło są w przeglądarce.
 */
interface Props {
    partners: CollectionEntry<"partners">[];
}

const { partners } = Astro.props;

const rendered = await Promise.all(
    partners.map(async (partner) => ({
        partner,
        Content: (await render(partner)).Content,
    })),
);
---

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
        partners.map((partner) => (
            <PartnerTile partner={partner} />
        ))
    }
</div>

{
    rendered.map(({ partner, Content }) => (
        <dialog
            id={`partner-${partner.id}`}
            class="m-auto w-[min(34rem,calc(100vw-2rem))] rounded-card border border-gray-200 bg-white p-0 backdrop:bg-ink/70 backdrop:backdrop-blur-sm"
            aria-labelledby={`partner-${partner.id}-title`}
        >
            <div class="flex items-start justify-between gap-4 border-b border-gray-200 p-6">
                <div>
                    <h2
                        id={`partner-${partner.id}-title`}
                        class="text-xl font-semibold text-gray-900"
                    >
                        {partner.data.name}
                    </h2>
                    {!partner.data.confirmed && (
                        <p class="mt-1 text-xs font-semibold tracking-wide text-amber-600 uppercase">
                            Rozmowy w toku
                        </p>
                    )}
                </div>
                <button
                    type="button"
                    data-close-partner
                    class="-m-2 rounded-md p-2 text-gray-400 transition-colors hover:text-gray-900"
                    aria-label="Zamknij"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        class="h-5 w-5"
                        aria-hidden="true"
                    >
                        <line x1="5" y1="5" x2="19" y2="19" />
                        <line x1="19" y1="5" x2="5" y2="19" />
                    </svg>
                </button>
            </div>

            <div class="prose-forge p-6 text-sm">
                <Content />
            </div>

            {partner.data.url && (
                <div class="border-t border-gray-200 p-6 pt-4">
                    <a
                        href={partner.data.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-medium text-brand-600 hover:text-brand-700"
                    >
                        Strona partnera ↗
                    </a>
                </div>
            )}
        </dialog>
    ))
}

<script>
    // Kafelek otwiera okno o tym samym id; `<dialog>` załatwia Esc i focus.
    document
        .querySelectorAll<HTMLButtonElement>("[data-partner]")
        .forEach((tile) => {
            tile.addEventListener("click", () => {
                const dialog = document.getElementById(
                    `partner-${tile.dataset.partner}`,
                ) as HTMLDialogElement | null;
                dialog?.showModal();
            });
        });

    document
        .querySelectorAll<HTMLButtonElement>("[data-close-partner]")
        .forEach((button) => {
            button.addEventListener("click", () =>
                button.closest("dialog")?.close(),
            );
        });

    // Kliknięcie w tło (poza kartą) też zamyka.
    document.querySelectorAll("dialog[id^='partner-']").forEach((dialog) => {
        dialog.addEventListener("click", (event) => {
            if (event.target === dialog) (dialog as HTMLDialogElement).close();
        });
    });
</script>
