---
/**
 * Panel infotainment: makieta interfejsu w lekkiej perspektywie, z żywym wykresem.
 * Makieta ma stałą szerokość i skaluje się do szerokości sceny — skalowanie siedzi
 * na osobnym opakowaniu, żeby nie nadpisać transformacji perspektywy.
 */
interface Props {
    class?: string;
}
const { class: className = "" } = Astro.props;

// Wysokości słupków i przesunięcia faz — inaczej cały wykres pulsuje unisono.
const BARS = [
    { h: "45%", delay: "0ms" },
    { h: "72%", delay: "180ms" },
    { h: "38%", delay: "360ms" },
    { h: "88%", delay: "120ms" },
    { h: "60%", delay: "300ms" },
    { h: "78%", delay: "60ms" },
];

const panelLabel =
    "text-[10px] font-extrabold tracking-[0.16em] text-white/45 uppercase";
const panel = "rounded-[10px] border border-white/10 bg-white/5 p-3";
---

<div
    aria-hidden="true"
    class:list={["absolute inset-0 grid place-items-center", className]}
>
    <div class="scale-[0.62] @sm:scale-[0.78] @md:scale-90 @lg:scale-100">
        <div
            class="w-[28rem] rounded-[18px] border border-white/16 bg-black/30 p-4 shadow-[0_20px_70px_rgba(0,0,0,.38)] [transform:perspective(1000px)_rotateX(7deg)_rotateY(-8deg)]"
        >
            <div class="flex gap-1.5 pb-3">
                <span class="h-[7px] w-[7px] rounded-full bg-white/25"></span>
                <span class="h-[7px] w-[7px] rounded-full bg-white/25"></span>
                <span class="h-[7px] w-[7px] rounded-full bg-white/25"></span>
            </div>

            <div class="grid grid-cols-[1.3fr_0.7fr] gap-2.5">
                <div class:list={[panel, "row-span-2 min-h-[10.5rem]"]}>
                    <p class={panelLabel}>Telemetria</p>
                    <div class="mt-5 flex h-[5.5rem] items-end gap-2">
                        {
                            BARS.map((bar) => (
                                <span
                                    class="flex-1 origin-bottom animate-bars rounded-t-[3px] bg-linear-to-b from-brand-600 to-brand-600/10"
                                    style={`height:${bar.h};animation-delay:${bar.delay}`}
                                />
                            ))
                        }
                    </div>
                </div>

                <div class:list={[panel, "min-h-[5rem]"]}>
                    <p class={panelLabel}>Zasilanie</p>
                    <p class="mt-2 text-xl font-bold text-brand-500">84%</p>
                </div>

                <div class:list={[panel, "min-h-[5rem]"]}>
                    <p class={panelLabel}>Tryb</p>
                    <p class="mt-2 text-sm font-semibold text-white/70">
                        Autonomia
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
