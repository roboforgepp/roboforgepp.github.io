---
import { Image } from "astro:assets";

import VisualStage from "./VisualStage.astro";
import RobotAssembly from "./RobotAssembly.astro";
import ArmVisual from "./ArmVisual.astro";
import LidarDiagram from "./LidarDiagram.astro";
import UiVisual from "./UiVisual.astro";
import HatVisual from "./HatVisual.astro";

import type { VisualKey } from "../../lib/projects";

/**
 * Dispatcher wizualizacji. Dopóki nie ma renderów i zdjęć, każdy projekt ma
 * animowaną grafikę zamiast pustej ramki (D12). Gdy pojawi się `cover`,
 * zdjęcie wygrywa i wizualizacja znika bez zmiany układu strony.
 */
interface Props {
    visual: VisualKey;
    cover?: ImageMetadata;
    coverAlt?: string;
    label?: string;
    /** Klasy wspólne dla zdjęcia i sceny — proporcje, zaokrąglenie, obramowanie. */
    class?: string;
    loading?: "lazy" | "eager";
}

const {
    visual,
    cover,
    coverAlt = "",
    label,
    class: className = "aspect-video rounded-card",
    loading = "lazy",
} = Astro.props;
---

{
    cover ? (
        <Image
            src={cover}
            alt={coverAlt}
            loading={loading}
            class:list={["w-full object-cover", className]}
        />
    ) : (
        <VisualStage label={label} class={className}>
            {visual === "robot" && <RobotAssembly module="wheels" />}
            {visual === "robot-legs" && <RobotAssembly module="legs" />}
            {visual === "robot-tracks" && <RobotAssembly module="tracks" />}
            {visual === "arm" && <ArmVisual />}
            {visual === "lidar" && <LidarDiagram />}
            {visual === "ui" && <UiVisual />}
            {visual === "hat" && <HatVisual />}
        </VisualStage>
    )
}
