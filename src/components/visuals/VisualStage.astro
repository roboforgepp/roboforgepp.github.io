---
/**
 * Ciemna scena, na której stoją wszystkie wizualizacje: siatka techniczna,
 * poświata i cień pod spodem. Dzięki niej same wizualizacje zajmują się
 * wyłącznie rysowaniem swojego obiektu.
 */
interface Props {
    /** Podpis w rogu, np. „Model koncepcyjny". */
    label?: string;
    class?: string;
}

const { label, class: className = "" } = Astro.props;
---

<div
    class:list={[
        // `@container` pozwala wizualizacjom o stałych wymiarach skalować się
        // do szerokości sceny, a nie do szerokości okna.
        "@container relative grid place-items-center overflow-hidden bg-ink",
        className,
    ]}
>
    <div
        aria-hidden="true"
        class="absolute inset-0 [background-image:linear-gradient(rgba(255,255,255,.045)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.045)_1px,transparent_1px)] [background-size:46px_46px]"
    >
    </div>
    <div
        aria-hidden="true"
        class="absolute inset-0 bg-[radial-gradient(circle_at_50%_45%,rgba(0,102,255,.18),transparent_42%)]"
    >
    </div>

    <slot />

    {
        label && (
            <span class="absolute bottom-5 left-6 z-3 text-[10px] font-extrabold tracking-[0.18em] text-white/45 uppercase">
                {label}
            </span>
        )
    }
</div>
