---
/**
 * Skaner otoczenia: obracające się pierścienie, węzeł i przesuwająca się linia skanu.
 * `label` opisuje węzeł w środku — poza projektami percepcji ta sama grafika
 * służy za „sygnał" (np. ON AIR przy audycji), stąd parametr zamiast literału.
 */
interface Props {
    label?: string;
    class?: string;
}
const { label = "LiDAR", class: className = "" } = Astro.props;
---

<div
    aria-hidden="true"
    class:list={["absolute inset-0 grid place-items-center", className]}
>
    <div class="relative aspect-square w-[62%] max-w-[21rem]">
        <div
            class="absolute inset-0 animate-rotate-ring rounded-full border border-brand-600/35"
        >
        </div>
        <div
            class="absolute inset-[18%] animate-rotate-ring-fast rounded-full border border-dashed border-white/20"
        >
        </div>
        <div
            class="absolute top-1/2 left-1/2 grid aspect-square w-[38%] -translate-x-1/2 -translate-y-1/2 rotate-45 place-items-center rounded-[22px] border-2 border-brand-600 bg-brand-600/10 shadow-[0_0_42px_rgba(0,102,255,.18)]"
        >
            <span
                class="-rotate-45 text-[11px] font-black tracking-[0.14em] text-brand-500"
                >{label}</span
            >
        </div>
        <div
            class="absolute inset-y-[10%] left-1/2 w-0.5 animate-scan bg-linear-to-b from-transparent via-brand-600 to-transparent shadow-[0_0_24px_var(--color-brand-600)]"
        >
        </div>
    </div>
</div>
