---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

import Layout from "../layouts/Layout.astro";
import Hero from "../components/ui/Hero.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import recruitmentPoster from "../assets/promo/plakat_promo_uncle_poz.png";
import StatsGrid from "../components/ui/StatsGrid.astro";
import SocialIcon from "../components/ui/SocialIcon.astro";
import QuoteBand from "../components/ui/QuoteBand.astro";
import ProjectCard from "../components/project/ProjectCard.astro";
import PartnerLogo from "../components/partners/PartnerLogo.astro";
import { getLatestProjects } from "../lib/projects";
import { getStats } from "../lib/stats";
import { RADIO_EPISODE, SOCIALS } from "../data/site";

const latest = await getLatestProjects(3);
const stats = await getStats();
const partners = (await getCollection("partners")).sort(
  (a, b) => a.data.order - b.data.order,
);

const statItems = [
  { value: stats.projects, label: "Projekty w kuźni" },
  { value: stats.bases, label: "Wymienne podstawy platformy" },
  { value: stats.sections, label: "Sekcje w kole" },
  { value: "∞", label: "Możliwości dalszej rozbudowy" },
];
---

<Layout>
  <Hero
    kicker="Koło Naukowe Politechniki Poznańskiej"
    titleLines={["Kujemy robota,", "którego chce", "się używać."]}
    description="Jesteśmy młodym kołem naukowym studentów Politechniki Poznańskiej. Budujemy modułową konstrukcję, którą można modyfikować pod własne potrzeby — od podstawy jezdnej po osprzęt na górze."
  >
    <Button href="/projects" variant="primary">Zobacz nasze projekty</Button>
    <Button href="/contact" variant="secondary">Dołącz do nas</Button>
    <div class="flex items-center gap-1 sm:ml-2">
      {
        SOCIALS.map((social) => (
          <SocialIcon
            href={social.href}
            label={social.label}
            icon={social.icon}
            class="text-white/50 hover:bg-white/10 hover:text-white"
          />
        ))
      }
    </div>
  </Hero>

  <!-- Rekrutacja: event na uczelni jest jutro, baner ma być pierwszą rzeczą po Hero. -->
  <Section tone="paper" space="default" size="wide">
    <div class="flex flex-col items-center gap-8" data-reveal>
      <a
        href="https://docs.google.com/forms/d/1IuSPouXB4nzsWj22VV_RXs2HqrLO6P6DDFbEjMOtsAU/viewform?edit_requested=true"
        target="_blank"
      >
        <Image
          src={recruitmentPoster}
          alt="Plakat rekrutacyjny: Chcemy Ciebie w RoboForge! Rekrutacja do koła naukowego trwa."
          class="w-full rounded-card border border-gray-200"
        />
      </a>

      <Button href="/contact" variant="primary">Dołącz do nas</Button>
    </div>
  </Section>

  <!-- Manifest -->
  <Section id="manifest" tone="white" space="loose" size="wide">
    <p
      data-reveal
      class="max-w-4xl text-3xl leading-tight font-bold tracking-tight text-balance sm:text-5xl"
    >
      Nie budujemy jednego robota.<br />
      <span class="text-gray-400"
        >Budujemy system, z którego może powstać wiele maszyn.</span
      >
    </p>
  </Section>

  <Section tone="white" space="tight" size="wide" divider>
    <StatsGrid items={statItems} />
  </Section>

  <!--
      Projekty. CTA celowo pod kartami, a nie w nagłówku: w nagłówku wisiało
      między opisem a siatką i rozbijało blok tekstu.
    -->
  <Section tone="white" space="default" size="wide">
    <SectionHeading
      eyebrow="Nad czym pracujemy"
      title="Technologia, która opuszcza ekran CAD-a"
      description="Najnowsze z kuźni. Każdy projekt ma własną podstronę z opisem, stanem prac i plikami do pobrania."
    />
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {latest.map((project) => <ProjectCard project={project} />)}
    </div>
    <div class="mt-10" data-reveal>
      <Button href="/projects" variant="secondary">
        Zobacz wszystkie projekty
      </Button>
    </div>
  </Section>

  <!-- Głos zespołu -->
  <QuoteBand
    tone="paper"
    eyebrow="Głos zespołu"
    quote="Nie chcemy kończyć na efektownych wizualizacjach. Każdy pomysł ma przejść przez warsztat, testy i kontakt z rzeczywistym problemem."
    author="Zarząd RoboForge"
  />

  <!-- RoboForge w eterze -->
  <Section tone="white" space="default" size="wide">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
      <SectionHeading
        eyebrow="RoboForge w eterze"
        title="Posłuchaj, jak opowiadamy o technologii"
        description="Pierwsza audycja jest już dostępna — zapis rozmowy o kole, projektach i drodze od pomysłu do prototypu."
      >
        <div class="mt-2 flex flex-wrap items-center gap-4">
          <Button href={RADIO_EPISODE.spotifyUrl} variant="primary" external>
            Otwórz w Spotify
          </Button>
          <Button href="/media" variant="secondary"> Media i sociale </Button>
        </div>
      </SectionHeading>

      <div data-reveal>
        <iframe
          src={RADIO_EPISODE.embedUrl}
          title={RADIO_EPISODE.title}
          width="100%"
          height="232"
          loading="lazy"
          allow="clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          class="block w-full border-0"></iframe>
      </div>
    </div>
  </Section>

  <!-- Zespół -->
  <Section tone="paper" space="default" size="wide">
    <SectionHeading
      eyebrow="Ludzie za projektem"
      title="Zespół"
      description="Mechanicy, elektronicy, informatycy i promocja. Pięć sekcji, jeden robot — zobacz, kto stoi za projektami."
      href="/team"
      cta="Poznaj cały zespół"
      class="max-w-2xl"
    />
  </Section>

  <!--
      Partnerzy jako ściana logotypów. Wcześniej był to rząd szarych nazw,
      przez co sekcja wyglądała na niedokończoną — te same dane w kafelkach
      trzymają rytm reszty strony i są gotowe na podmianę na prawdziwe logo.
    -->
  <Section tone="white" space="default" size="wide">
    <SectionHeading
      eyebrow="Wspólnie budujemy"
      title="Prototypy powstają dzięki dobrym partnerstwom"
      description="Firmy i instytucje, dzięki którym nasze projekty wychodzą poza ekran CAD-a."
    />
    <ul data-reveal class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        partners.map((partner) =>
          partner.data.url ? (
            <li class="flex flex-col gap-2">
              <a
                href={partner.data.url}
                target="_blank"
                rel="noopener noreferrer"
                class="block h-24 rounded-md border border-gray-200 transition-colors hover:border-brand-400"
              >
                <PartnerLogo partner={partner} class="h-full" />
              </a>
              {!partner.data.confirmed && (
                <span class="text-center text-xs text-gray-400">
                  w rozmowach
                </span>
              )}
            </li>
          ) : (
            <li class="flex flex-col gap-2">
              <PartnerLogo
                partner={partner}
                class="h-24 border border-gray-200"
              />
              {!partner.data.confirmed && (
                <span class="text-center text-xs text-gray-400">
                  w rozmowach
                </span>
              )}
            </li>
          ),
        )
      }
    </ul>
    <div class="mt-10" data-reveal>
      <Button href="/partners" variant="secondary"> Poznaj współpracę </Button>
    </div>
  </Section>

  <!-- Dołóż swoją iskrę -->
  <Section tone="ink" space="loose" size="wide">
    <div class="flex flex-col items-start gap-6">
      <h2
        data-reveal
        class="max-w-3xl text-4xl font-bold tracking-tight text-balance sm:text-6xl"
      >
        Dołóż swoją iskrę.
      </h2>
      <p
        data-reveal
        style="--reveal-delay:80ms"
        class="max-w-xl text-lg text-pretty text-(--tone-muted)"
      >
        Dołącz do zespołu albo zostań partnerem technologicznym. Najlepsze
        projekty zaczynają się od ludzi, którzy chcą zrobić pierwszy krok.
      </p>
      <div
        data-reveal
        style="--reveal-delay:160ms"
        class="mt-2 flex flex-wrap items-center gap-4"
      >
        <Button href="/contact" variant="primary"> Dołącz do koła </Button>
        <Button href="/partners" variant="secondary">
          Porozmawiajmy o współpracy
        </Button>
      </div>
    </div>
  </Section>
</Layout>
