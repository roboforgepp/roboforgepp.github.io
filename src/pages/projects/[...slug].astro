---
import { render } from "astro:content";

import Layout from "../../layouts/Layout.astro";
import Container from "../../components/layout/Container.astro";
import Section from "../../components/ui/Section.astro";
import Button from "../../components/ui/Button.astro";
import Tag from "../../components/ui/Tag.astro";
import ProjectStatus from "../../components/project/ProjectStatus.astro";
import ProjectCard from "../../components/project/ProjectCard.astro";
import ProjectVisual from "../../components/visuals/ProjectVisual.astro";
import { getPublishedProjects } from "../../lib/projects";
import { INK_TONE } from "../../lib/tone";

export async function getStaticPaths() {
    const projects = await getPublishedProjects();
    return projects.map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

// „Zobacz też" — reszta tej samej kategorii, a jak kategoria jest jednoosobowa,
// to cokolwiek innego, byle strona nie kończyła się ślepym zaułkiem.
const all = await getPublishedProjects();
const others = all.filter((entry) => entry.id !== project.id);
const sameCategory = others.filter(
    (entry) => entry.data.category === data.category,
);
const related = (sameCategory.length > 0 ? sameCategory : others).slice(0, 3);

const dateLabel = data.date.toLocaleDateString("pl-PL", {
    month: "long",
    year: "numeric",
});
---

<Layout title={data.title} description={data.summary}>
    <section
        class:list={[
            "relative isolate overflow-hidden bg-ink text-white",
            INK_TONE,
        ]}
    >
        <div
            aria-hidden="true"
            class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-[36rem] w-[36rem] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(0,102,255,.2),transparent_65%)] blur-3xl"
        >
        </div>

        <Container size="wide" class="py-14 sm:py-20">
            <nav aria-label="Ścieżka nawigacji" class="text-sm text-white/50">
                <a href="/projects" class="hover:text-white">Projekty</a>
                <span aria-hidden="true" class="px-2">/</span>
                <span class="text-white/80">{data.category}</span>
            </nav>

            <div class="mt-8 grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-center">
                <div>
                    <ProjectStatus
                        status={data.status}
                        placeholder={data.placeholder}
                    />
                    <h1
                        class="mt-5 text-4xl font-bold tracking-tight text-balance sm:text-5xl"
                    >
                        {data.title}
                    </h1>
                    <p class="mt-5 max-w-xl text-lg text-pretty text-white/64">
                        {data.summary}
                    </p>
                    {
                        data.tags.length > 0 && (
                            <ul class="mt-7 flex flex-wrap gap-2">
                                {data.tags.map((tag) => (
                                    <li>
                                        <Tag class="border-white/20 text-white/70">
                                            {tag}
                                        </Tag>
                                    </li>
                                ))}
                            </ul>
                        )
                    }
                </div>

                <ProjectVisual
                    visual={data.visual}
                    cover={data.cover}
                    coverAlt={data.coverAlt}
                    loading="eager"
                    label={data.cover ? undefined : "Wizualizacja poglądowa"}
                    class="aspect-[16/11] w-full rounded-card border border-white/10"
                />
            </div>
        </Container>
    </section>

    <Section size="wide" space="default">
        <div class="grid gap-12 lg:grid-cols-[1fr_16rem] lg:gap-16">
            <div class="prose-forge max-w-2xl">
                <Content />
            </div>

            <aside class="lg:border-l lg:border-gray-200 lg:pl-8">
                <dl class="flex flex-col gap-5 text-sm">
                    <div>
                        <dt class="text-xs tracking-widest text-gray-400 uppercase">
                            Kategoria
                        </dt>
                        <dd class="mt-1 font-medium text-gray-900">
                            {data.category}
                        </dd>
                    </div>
                    <div>
                        <dt class="text-xs tracking-widest text-gray-400 uppercase">
                            Start prac
                        </dt>
                        <dd class="mt-1 font-medium text-gray-900">
                            <time datetime={data.date.toISOString()}>
                                {dateLabel}
                            </time>
                        </dd>
                    </div>
                    <div>
                        <dt class="text-xs tracking-widest text-gray-400 uppercase">
                            Status
                        </dt>
                        <dd class="mt-2">
                            <ProjectStatus status={data.status} />
                        </dd>
                    </div>
                </dl>

                <div class="mt-8 border-t border-gray-200 pt-6">
                    <p class="text-xs tracking-widest text-gray-400 uppercase">
                        Pliki
                    </p>
                    {
                        data.downloads.length > 0 ? (
                            <ul class="mt-3 flex flex-col gap-2 text-sm">
                                {data.downloads.map((file) => (
                                    <li>
                                        <a
                                            href={file.href}
                                            download
                                            class="font-medium text-brand-600 hover:text-brand-700"
                                        >
                                            ↓ {file.label}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        ) : (
                            <p class="mt-3 text-sm text-gray-500">
                                Modele i dokumentacja pojawią się tu, gdy
                                konstrukcja wyjdzie z fazy projektu.
                            </p>
                        )
                    }
                </div>

                <div class="mt-8 border-t border-gray-200 pt-6">
                    <p class="text-sm text-gray-500">
                        Chcesz przy tym pracować albo wesprzeć projekt?
                    </p>
                    <Button href="/contact" variant="ghost" class="mt-2">
                        Napisz do nas
                    </Button>
                </div>
            </aside>
        </div>
    </Section>

    {
        related.length > 0 && (
            <Section tone="paper" size="wide" space="default">
                <h2 class="text-2xl font-bold tracking-tight text-gray-900">
                    Zobacz też
                </h2>
                <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    {related.map((entry) => (
                        <ProjectCard project={entry} />
                    ))}
                </div>
            </Section>
        )
    }
</Layout>
