---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import PlaceholderBox from "../components/ui/PlaceholderBox.astro";
import TeamSection from "../components/team/TeamSection.astro";
import { TEAM_SECTIONS } from "../data/site";
---

<Layout
    title="Zespół"
    description="Pięć sekcji koła RoboForge: zarząd, mechanicy, elektronicy, informatycy i promocja. Poznaj kowali stojących za modułową platformą robotyczną."
>
    <PageHeader
        eyebrow="Ludzie za projektem"
        title="Poznaj naszych kowali"
        description="RoboForge to koło interdyscyplinarne. Robot powstaje na styku mechaniki, elektroniki i oprogramowania, więc pracujemy w sekcjach, które muszą się dogadywać."
    />

    <Section tone="white" space="default" size="wide">
        <div class="grid gap-10 sm:grid-cols-2 sm:items-center">
            <SectionHeading
                eyebrow="Kim jesteśmy"
                title="Koło, które uczy się na realnych konstrukcjach"
                description="Zaczynamy od pomysłu, kończymy na czymś, co da się uruchomić, zmierzyć i poprawić. Nie ma tu podziału na tych, którzy projektują, i tych, którzy skręcają — każdy przechodzi całą drogę."
            />
            <div data-reveal>
                <PlaceholderBox
                    label="Zdjęcie zespołu"
                    awaiting="Dominik / sekcja promocji"
                />
            </div>
        </div>
    </Section>

    <Section tone="paper" space="default" size="wide">
        <SectionHeading eyebrow="Sekcje" title="Jak dzielimy pracę" />
        <div class="mt-8">
            {
                TEAM_SECTIONS.map((section) => (
                    <TeamSection
                        name={section.name}
                        description={section.description}
                        leaderName={section.leaderName}
                    />
                ))
            }
        </div>
    </Section>

    <Section tone="ink" space="default" size="wide">
        <SectionHeading
            eyebrow="Rekrutacja"
            title="Szukamy ludzi do każdej sekcji"
            description="Nie musisz umieć wszystkiego — wystarczy, że chcesz się nauczyć i masz czas raz w tygodniu usiąść nad projektem. Reszty nauczysz się przy konstrukcji."
        >
            <Button href="/contact" variant="primary" class="mt-2">
                Napisz do nas
            </Button>
        </SectionHeading>
    </Section>
</Layout>
