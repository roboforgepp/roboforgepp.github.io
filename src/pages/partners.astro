---
import { getCollection } from "astro:content";

import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import PartnerGrid from "../components/partners/PartnerGrid.astro";
import { CONTACTS } from "../data/site";

const partners = (await getCollection("partners")).sort(
    (a, b) => a.data.order - b.data.order,
);

const benefits = [
    {
        number: "01",
        title: "Widoczność wśród studentów",
        description:
            "Logo na stronie, w materiałach z pokazów i w relacjach z warsztatu. Docieramy do studentów kierunków technicznych Politechniki Poznańskiej.",
    },
    {
        number: "02",
        title: "Testy sprzętu w realnych warunkach",
        description:
            "Podzespoły trafiają do konstrukcji, która jeździ, a nie leży w szufladzie. Wracamy z konkretnym feedbackiem z eksploatacji.",
    },
    {
        number: "03",
        title: "Kontakt z przyszłymi inżynierami",
        description:
            "Członkowie koła kończą studia i szukają pracy. Partnerzy poznają ich przy projekcie, a nie na rozmowie kwalifikacyjnej.",
    },
];
---

<Layout
    title="Partnerzy"
    description="Firmy i instytucje wspierające koło naukowe RoboForge: Botland, MabRobotics, FreshDesign i PCSS. Zobacz, na czym polega współpraca."
>
    <PageHeader
        eyebrow="Wspólnie budujemy"
        title="Nasi dostawcy żelastwa do kucia projektów"
        description="Bez wsparcia z zewnątrz koło naukowe kończy się na rysunkach. Poniżej firmy i instytucje, dzięki którym nasze projekty wychodzą poza ekran CAD-a."
    />

    <Section tone="white" space="default" size="wide">
        <SectionHeading
            eyebrow="Partnerzy"
            title="Z kim pracujemy"
            description="Kliknij kafelek, żeby zobaczyć, co konkretnie zyskujemy dzięki danemu partnerowi."
            class="mb-10"
        />
        <PartnerGrid partners={partners} />
    </Section>

    <Section tone="paper" space="default" size="wide">
        <SectionHeading
            eyebrow="Dla firm"
            title="Co daje współpraca z RoboForge"
        />
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {
                benefits.map((benefit) => (
                    <Card tone="outline" class="bg-white" data-reveal>
                        <span class="text-sm font-bold text-brand-600 tabular-nums">
                            {benefit.number}
                        </span>
                        <h3 class="mt-3 text-lg font-semibold text-(--tone-fg)">
                            {benefit.title}
                        </h3>
                        <p class="mt-2 text-sm text-pretty text-(--tone-muted)">
                            {benefit.description}
                        </p>
                    </Card>
                ))
            }
        </div>
    </Section>

    <Section tone="ink" space="default" size="wide">
        <SectionHeading
            eyebrow="Zostań partnerem"
            title="Chcesz dołączyć do tej listy?"
            description="Napisz, co możesz zaoferować — podzespoły, czas maszynowy, wiedzę albo wsparcie finansowe. Odpowiemy z konkretną propozycją współpracy."
        >
            <Button
                href={`mailto:${CONTACTS[0].email}?subject=${encodeURIComponent("Współpraca z RoboForge")}`}
                variant="primary"
                class="mt-2"
            >
                {CONTACTS[0].email}
            </Button>
        </SectionHeading>
    </Section>
</Layout>
